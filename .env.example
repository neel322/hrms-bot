# GROQ API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
LLM_REASONING_EFFORT=none
LLM_TOOL_MAX_TOKENS=300
LLM_ANSWER_MAX_TOKENS=600
POLICY_MIN_SCORE=0.45

# Conversation History Configuration
HISTORY_MAX_MESSAGES=0 # 0 = no message-count cap; >0 caps history to the newest N messages
HISTORY_MAX_CHARS=24000 # Safety budget on total characters of history sent (~6k tokens) to prevent context overflows

# Qdrant Vector Database Configuration
# Leave QDRANT_URL empty to fallback to local embedded mode (./qdrant_data)
QDRANT_URL=
QDRANT_API_KEY=

# Supabase PostgreSQL Configuration
# Leave empty to fallback to local SQLite (./hrms.db)
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
DEMO_MODE=false
DEMO_PASSWORD=your_demo_password_here # one shared password for all seeded demo accounts, demos only; never use in production
ALLOW_DEMO_ON_NETWORK=false
COOKIE_SECURE=false
TZ_NAME=Asia/Kolkata
FAST_EMBED_CACHE_DIR=./models
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001"
